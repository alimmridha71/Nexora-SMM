# Postgres (Neon / Supabase / Railway). For `prisma db push` use the DIRECT (non-pooled) URL if your host gives both.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# openssl rand -hex 32   (encrypts provider API keys; never change after saving providers)
ENCRYPTION_KEY=""
# openssl rand -hex 32   (signs login cookies)
AUTH_SECRET=""
# openssl rand -hex 24   (Vercel sends this as a Bearer token to /api/cron/*)
CRON_SECRET=""

# Used only by `npm run db:seed` to create the first admin
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD=""
